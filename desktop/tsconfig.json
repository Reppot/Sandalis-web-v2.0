{
  "extends": "../frontend/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [],
    "baseUrl": "../frontend",
    "typeRoots": ["../frontend/node_modules/@types"],
    "paths": {
      "@/*": ["src/*"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom/*": ["node_modules/@types/react-dom/*"]
    }
  },
  "include": ["renderer/**/*.tsx", "../frontend/src/**/*.ts", "../frontend/src/**/*.tsx"],
  "exclude": ["node_modules", "../frontend/src/app/layout.tsx", "../frontend/src/app/robots.ts", "../frontend/src/app/sitemap.ts", "../frontend/src/app/api"]
}
