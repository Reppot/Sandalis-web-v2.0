# --- окружение ----------------------------------------------------------------
ENV=local                      # local | staging | prod
API_V1_PREFIX=/api/v1

# --- PostgreSQL / Supabase ------------------------------------------------------
# Можно без «+asyncpg» — app/core/db.py нормализует сам.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sandalis
# True при переходе на Supabase Pooler (порт 6543, transaction mode):
# выключает пул приложения (NullPool) и кэш prepared statements.
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
SQL_ECHO=false

# --- Auth ----------------------------------------------------------------------
JWT_SECRET=change-me-long-random
JWT_ALG=HS256
JWT_ISSUER=sandalis
JWT_AUDIENCE=sandalis-web
ACCESS_TOKEN_TTL_MIN=60
SESSION_COOKIE_NAME=sandalis_session
CLAN_TOKEN_HEADER=X-Clan-Token
# Служебный ключ для POST /api/v1/auth/dev-token. Пусто -> dev-выдача только
# при ENV != prod. Задан -> выдача разрешена при совпадении заголовка X-Dev-Auth-Key.
DEV_AUTH_SECRET=
DEV_AUTH_HEADER=X-Dev-Auth-Key

# --- Session cookie (Discord OAuth callback кладёт сюда stateless JWT) ----------
FRONTEND_URL=http://localhost:3000
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false               # в prod -> true
COOKIE_SAMESITE=lax               # lax | strict | none

# --- Discord OAuth (пусто -> /auth/discord/login отвечает 503 discord.disabled) --
DISCORD_API_BASE_URL=https://discord.com/api/v10
DISCORD_AUTHORIZE_URL=https://discord.com/oauth2/authorize
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback
DISCORD_OAUTH_STATE_TTL_SEC=600

# --- Bootstrap-аренда -----------------------------------------------------------
# Куда принимать discord-юзера без membership. Пусто -> 403 user.not_member.
DEFAULT_CLAN_ID=
DEFAULT_CLAN_ROLE=guest

# --- i18n ----------------------------------------------------------------------
DEFAULT_LOCALE=en
I18N_HOT_RELOAD=false          # true только для локальной разработки словарей
