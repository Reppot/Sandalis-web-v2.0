# Куда Next проксирует /api/* (server-side, читается при сборке и старте).
# Браузер ходит только на свой origin — кука сессии first-party.
BACKEND_URL=http://localhost:8000

# Оставьте пустым: запросы идут через прокси того же origin.
# Абсолютный URL — только для отладки без прокси (кука станет сторонней).
NEXT_PUBLIC_API_URL=

# S3 endpoint для иконок/медиа
NEXT_PUBLIC_CDN_URL=

# Показать форму dev-token в кабинете (бэкенд с ENV!=prod)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
